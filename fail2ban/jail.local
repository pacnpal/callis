[sshd]
enabled = true
# fail2ban cannot read environment variables in jail configs — if you change
# SSH_PORT from the default 2222 in .env, update this port to match.
port = 2222
filter = sshd
logpath = /var/log/callis-sshd/auth.log
maxretry = 3
findtime = 600
bantime = 86400

[recidive]
enabled = true
logpath = /var/log/fail2ban.log
banaction = %(banaction_allports)s
maxretry = 3
findtime = 86400
bantime = -1
